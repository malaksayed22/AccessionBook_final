# Copy to .env (never commit .env). Every variable is validated at startup by src/server/env.ts.

NODE_ENV=development
APP_URL=http://localhost:4000
LOG_LEVEL=info
# Laboratory time zone: regulatory days and CTLS periods are calendar days here.
LAB_TIMEZONE=America/Toronto
# Licence number printed on CTLS reports.
# LAB_LICENSE_ID=

# PostgreSQL 16. Start one locally with `npm run db:start` (no Docker needed)
# or `docker compose up -d postgres`; both serve this URL.
DATABASE_URL=postgresql://accession:accession-dev-only@localhost:5432/accession_book

# --- Sessions and sign-in (defaults shown) ---
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# Reverse proxies in front of the app (AWS ALB = 1). 0 ignores X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1

# --- Two-step verification and re-authentication ---
# Default true in production, false elsewhere. Set true locally to test the production flow.
# REQUIRE_ADMIN_MFA=true
# REQUIRE_REAUTH=true
# REAUTH_WINDOW_MINUTES=10
# Mandatory in production: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=

# --- File storage ---
# STORAGE_DRIVER=disk
# STORAGE_DIR=.local/uploads
# STORAGE_DRIVER=s3 also needs S3_BUCKET, S3_REGION (ca-central-1), S3_KMS_KEY_ID.
# AWS credentials come from the task role, never from env.

# --- Modules ---
# Standard operating procedures (Quality > Procedures) are off until the lab adopts them.
# ENABLE_SOPS=true
